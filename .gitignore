# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (workspace-wide)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (workspace-wide)
.next/
out/

# production
build/
# /docs

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent generated
.agents/
.claude/
skills-lock.json
**/src/lib/init.ts

# SQLite database
data/
data-test/
*.db
*.db-journal
*.db-wal
*.db-shm

# Trae 缓存
.trae-html-share-packages/

# 临时 worktree（残留目录，避免被当作 embedded repo）
.worktree-main/
