{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@novel/contracts/serializers": [
        "../../packages/contracts/dist/serializers/index"
      ],
      "@novel/contracts/*": [
        "../../packages/contracts/dist/*"
      ],
      "@novel/auth/*": [
        "../../packages/auth/dist/*"
      ],
      "@novel/contracts": [
        "../../packages/contracts/dist/index"
      ],
      "@novel/auth": [
        "../../packages/auth/dist/index"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "__tests__",
    "vitest.config.ts"
  ]
}
