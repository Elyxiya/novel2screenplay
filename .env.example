# Novel2Screenplay 环境模板 —— 复制为 .env.local 后按需填写
# 所有密钥值永不入库，仅本地维护。

# === LLM API Keys ===
# 必填：DeepSeek（主 LLM）
DEEPSEEK_API_KEY=
# 可选：OpenAI
OPENAI_API_KEY=

# === DeepSeek 模型选择 ===
# Options: deepseek-chat (V3), deepseek-reasoner (R1), or other model IDs
DEEPSEEK_MODEL_ID=deepseek-chat

# === 模型配置（可选）===
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=16384

# === 数据库 ===
# 存储位置（SQLite 用，默认 <workspace>/data）
# DB_DIR=./data
# DB_FILE=novel2screenplay.db

# 启用 PostgreSQL 后端：配置连接串后引擎按 DATABASE_URL 探择（PG 优先，连接不可用自动回退 SQLite）。
# 若留空则使用默认 SQLite。
# DATABASE_URL=postgres://user:pass@localhost:5432/novel2screenplay

# PG 同步执行模式（本阶段固定为 worker + Atomics 同步桥；保留开关以便后续扩展异步模式）：
# STORAGE_SYNC_MODE=bridge