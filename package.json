{
  "name": "novel2screenplay",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted novel to screenplay conversion - monorepo (P1)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @novel/screenplay",
    "build": "npm run build --workspace @novel/screenplay",
    "start": "npm run start --workspace @novel/screenplay",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
