registry=https://registry.npmjs.org/
better_sqlite3_binary_host_mirror=https://registry.npmmirror.com/-/binary/better-sqlite3/
# 本机环境约束：
# 1) E: 盘 NTFS 上目录级原子改名（rename tmp -> final）系统性 EPERM（索引/杀软瞬时锁）；
# 2) Windows junction/symlink 不可用，pnpm isolated 布局的 workspace 链接退化为
#    真实目录复制，导致 next/better-sqlite3 等运行时无法向上解析传递依赖。
# 因此：hoisted 布局（全部依赖提升到 root node_modules，Node 向上解析天然可达）
# + package-import-method=copy（store 导入走复制，避免目录 rename）。
node-linker=hoisted
package-import-method=copy
