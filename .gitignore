# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (workspace-wide)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (workspace-wide)
.next/
.next*/
out/

# production
build/
# /docs

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workspace 包构建产物（CI 中由构建顺序生成）
packages/*/dist/

# agent generated
.agents/
.claude/
skills-lock.json
**/src/lib/init.ts

# SQLite database
data/
data-test/
*.db
*.db-journal
*.db-wal
*.db-shm

# 本地 IDE 插件 bundle（按 profile 安装，不属于产品代码）
plugins/

# Trae 缓存
.trae-html-share-packages/

# 临时 worktree（残留目录，避免被当作 embedded repo）
.worktree-main/

# Chrome CDP 截图临时 profile（外部 --user-data-dir 启动，被进程占用时无法删除）
.chrome-cdp-tmp/
# 早期验证截图（本地资产，不入库）
.verify-shots/

# 工作流产物：E2E / shot 脚本与截图证据不入库（本地保留运行能力）
scripts/e2e/
scripts/shot/
pr-evidence/

# PPT 构建脚本（本地生成 docs/答辩演示.pptx 用）
.deck/


/docs/项目立项文档.md
/docs/产品定义.md
/docs/README.md
/docs/简历亮点验证报告.md
/docs/项目介绍完整文档.md
