{
  "name": "@novel/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Novel2Screenplay 共享契约：Zod schema、校验器与序列化器",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./novel": { "types": "./dist/novel.d.ts", "default": "./dist/novel.js" },
    "./screenplay": { "types": "./dist/screenplay.d.ts", "default": "./dist/screenplay.js" },
    "./drama": { "types": "./dist/drama.d.ts", "default": "./dist/drama.js" },
    "./validator": { "types": "./dist/validator.d.ts", "default": "./dist/validator.js" },
    "./serializers": { "types": "./dist/serializers/index.d.ts", "default": "./dist/serializers/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
